# CanvasFlow web — Environment Variables Template

NODE_ENV=development

# api-gateway base URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# sync-server's HTTP port (PORT_HTTP — the one serving /health, not the
# WebSocket). Server-to-server only: access changes are pushed here so they
# land on live editing sessions at once rather than at the next sweep.
# The call is authenticated with a value derived from AUTH_SECRET, so this
# and the sync-server must share that secret.
SYNC_INTERNAL_URL=http://localhost:4001

# Auth.js — generated via: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth 
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Database (Consumed by @canvasflow/db) — Neon, format:
#   postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=