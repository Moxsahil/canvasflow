# CanvasFlow web — copy to .env and fill in.

NODE_ENV=development

# Where this app sends people and requests.
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_EDITOR_URL=http://localhost:3002

# The same value as the gateway and the sync-server: this app verifies the
# gateway's session tokens and mints board tokens with it.
AUTH_SECRET=

# The sync-server's HTTP port (not the WebSocket one). Server-to-server only:
# access changes are pushed here so they reach live editors at once.
SYNC_INTERNAL_URL=http://localhost:4001

# Same database as the rest of the repo (see the root .env).
DATABASE_URL=
