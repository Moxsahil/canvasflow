# CanvasFlow editor — copy to .env. All three are required; the editor refuses
# to start without them.

# The API gateway: board tokens, account, images.
VITE_API_URL=http://localhost:3001
# The web app: sign-in, /open, workspaces, sharing.
VITE_WEB_URL=http://localhost:3000
# The sync-server's WebSocket port.
VITE_SYNC_URL=ws://localhost:4000
