{
  "name": "@canvasflow/editor",
  "version": "0.0.0",
  "private": true,
  "description": "CanvasFlow editor — Vite + React canvas application",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3002 --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3002",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@canvasflow/canvas-engine": "workspace:*",
    "@canvasflow/types": "workspace:*",
    "@canvasflow/ui": "workspace:*",
    "@hocuspocus/provider": "^4.5.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@xstate/react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "png-chunk-text": "^1.0.0",
    "png-chunks-encode": "^1.0.0",
    "png-chunks-extract": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "uqr": "^0.1.3",
    "xstate": "^5.32.2",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@canvasflow/config": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^2.1.8"
  }
}
