# The local end-to-end stack (`pnpm --filter @canvasflow/e2e test:e2e:local`).
#
# Every value here is fake and only ever used on this machine: a throwaway
# Postgres, a fake mail server and the four apps on their own ports, so a run
# never touches Neon, Resend, Fly, Vercel or the dev servers on 3000–3002.
# local/run.mjs refuses to start if any address below is not loopback.

E2E_WEB_URL=http://localhost:3100
E2E_GATEWAY_URL=http://localhost:3101
E2E_EDITOR_URL=http://localhost:3102
E2E_SYNC_PORT=4100
E2E_SYNC_HTTP_PORT=4101
E2E_MAIL_PORT=4102
E2E_PG_PORT=54400

# Shared by the web app, gateway and sync-server, as in production.
E2E_AUTH_SECRET=local-e2e-auth-secret-not-used-anywhere-else-000000
E2E_DIGEST_TRIGGER_SECRET=local-e2e-digest-trigger-secret-not-used-anywhere-00

# The account auth.setup.ts signs in with. Created fresh on every run.
E2E_EMAIL=delivered+e2e-owner@resend.dev
E2E_PASSWORD=E2e!Local-owner1
