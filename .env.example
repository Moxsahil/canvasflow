# CanvasFlow — root environment
# Copy to .env. Read by the database package's scripts (migrate, seed, prune)
# and by the end-to-end tests. Each app and service has its own .env as well —
# see the .env.example beside it. Never commit a real .env.

NODE_ENV=development

# Postgres (Neon). Format:
#   postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Use the development database here; migrations run against whatever this is.
DATABASE_URL=
