# CanvasFlow sync-server — copy to .env and fill in.

NODE_ENV=development
# The WebSocket port the editor connects to, and the HTTP port for /health
# and the web app's internal calls.
PORT_WS=4000
PORT_HTTP=4001

# The same value as the gateway and the web app: board tokens are verified
# with it, and the internal-call credential is derived from it.
AUTH_SECRET=

# Same database as the rest of the repo (see the root .env).
DATABASE_URL=

# Origins allowed to open a socket, besides localhost in development.
# WEB_URL=
# EDITOR_URL=

# Optional. Needed only to run more than one instance: rooms are fanned out
# through Redis. Leave unset for a single instance.
# REDIS_URL=

LOG_LEVEL=info
