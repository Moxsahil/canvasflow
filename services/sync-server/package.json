{
  "name": "@canvasflow/sync-server",
  "version": "0.0.0",
  "private": true,
  "description": "Hocuspocus WebSocket sync server for CanvasFlow — Yjs relay + persistence for real-time collaboration",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch --clear-screen=false --env-file=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "compact:updates": "tsx --env-file=.env scripts/compact-board-updates.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@canvasflow/db": "workspace:*",
    "@canvasflow/types": "workspace:*",
    "@hocuspocus/extension-redis": "^2.15.3",
    "@hocuspocus/server": "^2.15.0",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.2",
    "jose": "^6.2.3",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@canvasflow/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^25.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
