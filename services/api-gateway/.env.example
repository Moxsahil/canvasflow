# CanvasFlow api-gateway — copy to .env and fill in.

NODE_ENV=development
PORT=3001

# Same database as the rest of the repo (see the root .env).
DATABASE_URL=

# Signs every session, board and guest token. At least 32 characters, and the
# same value in the web app and the sync-server. Generate: openssl rand -base64 32
AUTH_SECRET=

# The web app and the editor: the two origins CORS admits. WEB_URL is also what
# verification and reset links are built from.
WEB_URL=http://localhost:3000
EDITOR_URL=http://localhost:3002

# This service's own public address, used for the OAuth callback URLs.
API_PUBLIC_URL=http://localhost:3001

# Production only. The parent domain the session cookies are shared on
# (e.g. .canvasflowapp.com); leave unset locally.
# SESSION_COOKIE_DOMAIN=

# Production only. Proxies in front of this service (2 behind Cloudflare + Fly)
# and the secret Cloudflare adds to every request. See docs/edge-protection.md.
TRUST_PROXY_HOPS=0
# ORIGIN_AUTH_SECRET=

# Optional settings are commented out: set them only with real values (an
# empty RESEND_API_KEY, for one, fails validation).

# Sign in with Google / GitHub. Optional: without them the buttons say the
# provider is unavailable. Callback: {API_PUBLIC_URL}/auth/oauth/{provider}/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Email (Resend): verification, password reset, password changed. Optional
# locally: without a key, mail is logged as not sent and nothing else fails.
# RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Image and avatar storage (Cloudflare R2). Optional: without it, only the
# image routes refuse. The bucket needs a CORS policy allowing the editor's
# origin with GET and PUT and the content-type header.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Tracing. Optional: leave unset to skip exporting.
# OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=api-gateway
