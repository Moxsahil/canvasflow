# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
.turbo/
out/
*.tsbuildinfo

# Environment files (NEVER commit secrets)
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/

# Test coverage
coverage/
*.lcov

# Temp
tmp/
temp/

# Local-only reference media (videos/images), not for git
apps/editor/src/error/

# Playwright
# .auth holds a real signed-in session — live cookies for whatever account
# the suite logs in as. Committing it hands that session to anyone with the
# repo, and it would go stale within the day regardless.
apps/e2e/playwright/.auth/
apps/e2e/playwright-report/
apps/e2e/test-results/
